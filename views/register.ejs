<!DOCTYPE html>
<html>
<head>
    <title>Register</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

<div class="container">

    <div class="links-div">
        <a class="link" href="/">Home</a>
        <a class="link" href="/login-page">Login</a>
    </div>

    <h1>Register</h1>

    <form action="/register" method="post">

        <input
            type="text"
            name="name"
            placeholder="Enter Name"
            required
        >

        <input
            type="email"
            name="email"
            placeholder="Enter Email"
            required
        >

        <input
            type="password"
            name="password"
            placeholder="Enter Password"
            required
        >

        <button type="submit">
            Register
        </button>

    </form>

</div>

</body>
</html>